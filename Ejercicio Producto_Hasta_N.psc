Algoritmo ProductoHastaN
    Definir N, i Como Entero
    Definir producto Como Real
    
    producto = 1
    
    Escribir "Ingrese el valor de N:"
    Leer N
    
    Para i = 1 Hasta N Hacer
        producto = producto * i
    FinPara
    
    Escribir "El producto desde 1 hasta ", N, " es: ", producto
FinAlgoritmo