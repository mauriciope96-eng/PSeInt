Algoritmo MenoresIgualesA25
    Definir i, numero Como Entero
    
    Para i = 1 Hasta 20 Hacer
        Escribir "Ingrese el número ", i, ":"
        Leer numero
        Si numero <= 25 Entonces
            Escribir "-> El número ", numero, " es menor o igual a 25."
        FinSi
    FinPara
FinAlgoritmo