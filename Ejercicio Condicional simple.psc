// El sistema debe permitir al usuario visualizar un número
//El sistema debe permitir al usuario visualizar otro número
//El sistema debe permitir al usuario visualizar cual de los números es mayor

Algoritmo Condicional_Simple
	
	Definir n1, n2 Como Entero
	Escribir "Ingrese un número"
	Leer n1
	Escribir "Ingrese el segundo número"
	Leer n2	
	
	Si (n1 > n2) Entonces
		Imprimir "El número " n1 " es mayor " 
	SiNo
		Imprimir "El número " n2 " es mayor " 
	Fin Si
	
FinAlgoritmo
