Algoritmo datos_personales
	
	//definimos las variables
	
	Definir nom, ape, edad, correo, num_tel, fecha_naci Como Caracter
	
	//Entrada de datos
	
	Escribir "Por favor escribe tu nombre completo"
	Leer nom
	Escribir "Por favor escribe tus apellidos"
	leer ape
	Escribir "Por favor escribe tu edad"
	leer edad
	Escribir "Por favor escribe tu correo electronico"
	leer correo
	Escribir "Por favor escribe tu número de teléfono"
	Leer num_tel
	Escribir "Por favor escribe tu fecha de nacimiento"
	Leer fecha_naci
	
	//Salida de Datos
	
	Imprimir "Sus Nombres y Apellidos son: " nom " " ape
	Imprimir "Tu edad es: " edad
	Imprimir "Tu correo electronico es: " correo
	Imprimir "Tu número de teléfomo es: " num_tel
	Imprimir "Tu fecha de nacimiento es: " fecha_naci
	
	
	
	
FinAlgoritmo
